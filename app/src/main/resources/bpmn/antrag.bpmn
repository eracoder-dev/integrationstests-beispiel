<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_Antrag" targetNamespace="http://beispiel.de/antragsbearbeitung">

  <bpmn:process id="antrag" name="Antrag auf Vertragsabschluss" isExecutable="true" camunda:historyTimeToLive="30">

    <bpmn:startEvent id="Start" name="Antrag erfasst">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- asyncBefore: Der Schritt läuft im Job Executor. Der REST-Aufruf, der den Antrag erfasst,
         wartet nicht auf den Adressdienst. Schlägt er fehl, versucht es der Job Executor dreimal. -->
    <bpmn:serviceTask id="Risiko" name="Risiko prüfen" camunda:asyncBefore="true"
                      camunda:delegateExpression="${risikopruefung}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT10S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="AdresseUngueltig" name="Adresse ungültig" attachedToRef="Risiko">
      <bpmn:outgoing>F_Fehler</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Fehler_Adresse"/>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="GW_Automatisch" name="Automatisch annehmbar?" default="F_Manuell">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_Auto</bpmn:outgoing>
      <bpmn:outgoing>F_Manuell</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Manuell" name="Manuelle Prüfung" camunda:candidateGroups="risikopruefung">
      <bpmn:incoming>F_Manuell</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_Entscheidung" name="Entscheidung" default="F_Nein">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F_Ja</bpmn:outgoing>
      <bpmn:outgoing>F_Nein</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Police" name="Police erstellen" camunda:delegateExpression="${policierung}">
      <bpmn:incoming>F_Auto</bpmn:incoming>
      <bpmn:incoming>F_Ja</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Ablehnen" name="Antrag ablehnen" camunda:delegateExpression="${ablehnung}">
      <bpmn:incoming>F_Nein</bpmn:incoming>
      <bpmn:incoming>F_Fehler</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="Ende_OK" name="Police erstellt">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Ende_Abgelehnt" name="Antrag abgelehnt">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Risiko"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Risiko" targetRef="GW_Automatisch"/>
    <bpmn:sequenceFlow id="F_Auto" name="ja" sourceRef="GW_Automatisch" targetRef="Police">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${automatisch}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Manuell" name="nein" sourceRef="GW_Automatisch" targetRef="Manuell"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Manuell" targetRef="GW_Entscheidung"/>
    <bpmn:sequenceFlow id="F_Ja" name="annehmen" sourceRef="GW_Entscheidung" targetRef="Police">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${entscheidung == 'annehmen'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_Nein" name="ablehnen" sourceRef="GW_Entscheidung" targetRef="Ablehnen"/>
    <bpmn:sequenceFlow id="F_Fehler" sourceRef="AdresseUngueltig" targetRef="Ablehnen"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Police" targetRef="Ende_OK"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Ablehnen" targetRef="Ende_Abgelehnt"/>
  </bpmn:process>

  <bpmn:error id="Fehler_Adresse" name="Adresse ungültig" errorCode="ADRESSE_UNGUELTIG"/>

  <bpmndi:BPMNDiagram id="Diagramm_Antrag">
    <bpmndi:BPMNPlane id="Ebene_Antrag" bpmnElement="antrag">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="152" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="133" y="145" width="74" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Risiko_di" bpmnElement="Risiko"><dc:Bounds x="240" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AdresseUngueltig_di" bpmnElement="AdresseUngueltig"><dc:Bounds x="272" y="142" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="312" y="175" width="60" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Automatisch_di" bpmnElement="GW_Automatisch" isMarkerVisible="true"><dc:Bounds x="395" y="95" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="376" y="55" width="88" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Manuell_di" bpmnElement="Manuell"><dc:Bounds x="500" y="190" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Entscheidung_di" bpmnElement="GW_Entscheidung" isMarkerVisible="true"><dc:Bounds x="655" y="205" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="652" y="262" width="56" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Police_di" bpmnElement="Police"><dc:Bounds x="780" y="80" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ablehnen_di" bpmnElement="Ablehnen"><dc:Bounds x="780" y="300" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende_OK_di" bpmnElement="Ende_OK"><dc:Bounds x="942" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="922" y="145" width="76" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ende_Abgelehnt_di" bpmnElement="Ende_Abgelehnt"><dc:Bounds x="942" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="918" y="365" width="84" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="188" y="120"/><di:waypoint x="240" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="340" y="120"/><di:waypoint x="395" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Auto_di" bpmnElement="F_Auto"><di:waypoint x="445" y="120"/><di:waypoint x="780" y="120"/>
        <bpmndi:BPMNLabel><dc:Bounds x="605" y="102" width="12" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Manuell_di" bpmnElement="F_Manuell"><di:waypoint x="420" y="145"/><di:waypoint x="420" y="230"/><di:waypoint x="500" y="230"/>
        <bpmndi:BPMNLabel><dc:Bounds x="426" y="185" width="22" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="600" y="230"/><di:waypoint x="655" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Ja_di" bpmnElement="F_Ja"><di:waypoint x="705" y="230"/><di:waypoint x="830" y="230"/><di:waypoint x="830" y="160"/>
        <bpmndi:BPMNLabel><dc:Bounds x="740" y="212" width="52" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Nein_di" bpmnElement="F_Nein"><di:waypoint x="680" y="255"/><di:waypoint x="680" y="340"/><di:waypoint x="780" y="340"/>
        <bpmndi:BPMNLabel><dc:Bounds x="686" y="296" width="48" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Fehler_di" bpmnElement="F_Fehler"><di:waypoint x="290" y="178"/><di:waypoint x="290" y="340"/><di:waypoint x="780" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="880" y="120"/><di:waypoint x="942" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="880" y="340"/><di:waypoint x="942" y="340"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
