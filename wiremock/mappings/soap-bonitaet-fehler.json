{
  "name": "SOAP-Fault (Name enthält Fehler)",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/soap/bonitaet",
    "bodyPatterns": [
      {
        "contains": "Fehler"
      }
    ]
  },
  "response": {
    "status": 500,
    "headers": {
      "Content-Type": "text/xml; charset=utf-8"
    },
    "body": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soapenv:Body>\n    <soapenv:Fault>\n      <faultcode>soapenv:Server</faultcode>\n      <faultstring>Auskunftssystem vorübergehend nicht verfügbar</faultstring>\n    </soapenv:Fault>\n  </soapenv:Body>\n</soapenv:Envelope>\n"
  }
}
