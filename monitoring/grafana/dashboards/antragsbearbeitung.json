   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(wildfly_transactions_number_of_committed_transactions_total[1m]) * 60",
     "legendFormat": "festgeschrieben",
