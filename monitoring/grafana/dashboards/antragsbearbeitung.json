   "type": "stat",
   "title": "Bereit (/health/ready)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 5,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=\"health\", instance=\"http://wildfly:9990/health/ready\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "JA",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "NEIN",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
