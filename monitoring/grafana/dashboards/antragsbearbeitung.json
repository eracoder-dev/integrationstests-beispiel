    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(wildfly_transactions_number_of_aborted_transactions_total[1m]) * 60",
     "legendFormat": "abgebrochen",
     "refId": "C"
    }
